{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "datasource.schema.v1",
  "title": "DatasourceModel",
  "type": "object",
  "required": [
    "name",
    "endpoints"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "method",
          "path",
          "returns"
        ],
        "properties": {
          "actor": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "deterministic",
              "schema-structural",
              "schema-interpreted",
              "llm-inferred",
              "human-confirmed"
            ]
          },
          "confidence": {
            "type": "number"
          },
          "confidenceSource": {
            "enum": [
              "deterministic",
              "second-party",
              "human-attested"
            ]
          },
          "requiresApproval": {
            "type": "boolean"
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trace": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string"
          },
          "returns": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "actor": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "deterministic",
        "schema-structural",
        "schema-interpreted",
        "llm-inferred",
        "human-confirmed"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "confidenceSource": {
      "enum": [
        "deterministic",
        "second-party",
        "human-attested"
      ]
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
