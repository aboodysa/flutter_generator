{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "query.schema.v1",
  "title": "QueryModel",
  "type": "object",
  "required": ["name", "fields"],
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "default": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "paramMap": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
