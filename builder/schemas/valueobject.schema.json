{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "valueobject.schema.v1",
  "title": "ValueObjectModel",
  "type": "object",
  "required": [
    "name",
    "baseType"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "baseType": {
      "enum": [
        "String",
        "int",
        "double",
        "DateTime"
      ]
    },
    "invariants": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "actor": {
                "type": "string"
              },
              "origin": {
                "enum": [
                  "deterministic",
                  "schema-structural",
                  "schema-interpreted",
                  "llm-inferred",
                  "human-confirmed"
                ]
              },
              "confidence": {
                "type": "number"
              },
              "confidenceSource": {
                "enum": [
                  "deterministic",
                  "second-party",
                  "human-attested"
                ]
              },
              "requiresApproval": {
                "type": "boolean"
              },
              "source": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "trace": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "enum": [
                  "min",
                  "max"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "actor": {
                "type": "string"
              },
              "origin": {
                "enum": [
                  "deterministic",
                  "schema-structural",
                  "schema-interpreted",
                  "llm-inferred",
                  "human-confirmed"
                ]
              },
              "confidence": {
                "type": "number"
              },
              "confidenceSource": {
                "enum": [
                  "deterministic",
                  "second-party",
                  "human-attested"
                ]
              },
              "requiresApproval": {
                "type": "boolean"
              },
              "source": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "trace": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "const": "nonEmpty"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "actor": {
                "type": "string"
              },
              "origin": {
                "enum": [
                  "deterministic",
                  "schema-structural",
                  "schema-interpreted",
                  "llm-inferred",
                  "human-confirmed"
                ]
              },
              "confidence": {
                "type": "number"
              },
              "confidenceSource": {
                "enum": [
                  "deterministic",
                  "second-party",
                  "human-attested"
                ]
              },
              "requiresApproval": {
                "type": "boolean"
              },
              "source": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "trace": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "const": "regex"
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "actor": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "deterministic",
        "schema-structural",
        "schema-interpreted",
        "llm-inferred",
        "human-confirmed"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "confidenceSource": {
      "enum": [
        "deterministic",
        "second-party",
        "human-attested"
      ]
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
