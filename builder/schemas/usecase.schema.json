{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "usecase.schema.v1",
  "title": "UseCaseModel",
  "type": "object",
  "required": [
    "name",
    "repository",
    "operation",
    "paramType",
    "returnType"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "paramType": {
      "type": "string"
    },
    "returnType": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "deterministic",
        "schema-structural",
        "schema-interpreted",
        "llm-inferred",
        "human-confirmed"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "confidenceSource": {
      "enum": [
        "deterministic",
        "second-party",
        "human-attested"
      ]
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
