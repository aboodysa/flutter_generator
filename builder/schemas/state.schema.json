{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "state.schema.v1",
  "title": "StateModel",
  "type": "object",
  "required": ["name", "entity"],
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "entity": { "type": "string" },
    "statuses": { "type": "array", "items": { "type": "string" } },
    "extraFields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "default": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
