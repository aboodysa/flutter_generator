{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "screen.schema.v1",
  "title": "ScreenModel",
  "type": "object",
  "required": [
    "name",
    "entity",
    "type",
    "state"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "entity": {
      "type": "string"
    },
    "type": {
      "enum": [
        "list",
        "detail",
        "wizard"
      ]
    },
    "state": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "validate": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "actor": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "deterministic",
        "schema-structural",
        "schema-interpreted",
        "llm-inferred",
        "human-confirmed"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "confidenceSource": {
      "enum": [
        "deterministic",
        "second-party",
        "human-attested"
      ]
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
