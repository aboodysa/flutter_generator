{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "screen.schema.v1",
  "title": "ScreenModel",
  "type": "object",
  "required": [
    "name",
    "entity",
    "type",
    "state"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "entity": {
      "type": "string"
    },
    "type": {
      "enum": [
        "list",
        "detail",
        "wizard",
        "sections"
      ]
    },
    "state": {
      "type": "string"
    },
    "export": {
      "enum": [
        "csv",
        "json",
        "csv+json"
      ],
      "description": "L3: only meaningful on a \"list\" screen — adds an Export action; requires the shown entity to declare a bool field named 'exported'."
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validate": {
            "type": "string"
          },
          "when": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "field",
                  "op",
                  "value"
                ],
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "op": {
                    "enum": [
                      ">=",
                      "<",
                      "=="
                    ]
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "hero": {
      "type": "string",
      "description": "S1: optional field name or literal headline rendered as the screen's focal point (only visible when the archetype's composition.ts entry has hasHero:true)."
    },
    "sections": {
      "type": "array",
      "description": "S2 (SPIKE_S2_REPORT.md §14.1): declarative section-list layout — only meaningful when type=='sections' (validate.ts's [sections] gate enforces the pairing). Order IS the hierarchy. No columns/width/height/aspectRatio/padding/x/y anywhere — additionalProperties:false closes each section object to exactly {id, type, title?, children?, target?}.",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "enum": ["header", "search", "hero", "promoBanner", "productGrid", "horizontalCards", "sectionHeader", "section", "divider", "floatingCart"]
          },
          "title": { "type": "string" },
          "target": {
            "type": "string",
            "description": "V1.1: only meaningful on type=='floatingCart' — a route to navigate to (e.g. \"/quiz-run/wizard\") instead of the decorative cart FAB. Absent = today's cart FAB, byte-identical. `title` becomes the FAB's extended label."
          },
          "children": {
            "type": "array",
            "description": "Only meaningful on type=='section' — depth-1, leaves only (no nested children).",
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": { "type": "string" },
                "type": {
                  "enum": ["header", "search", "hero", "promoBanner", "productGrid", "horizontalCards", "sectionHeader", "divider", "floatingCart"]
                },
                "title": { "type": "string" },
                "target": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "visualStyle": {
      "type": "object",
      "description": "S1 (SPIKE_S1_REPORT.md §14.1, D1/D2): per-screen visual-intent fragment. Feeds composition.ts's deterministic visualFor scoring selector only — never selects a widget/asset directly. density stays app-level (AppAttributes.density), not duplicated here. imagery (S3) and emphasis (S2) are deliberately NOT part of this v1 set (D2/D3) — the [visualIntent] gate rejects them if present.",
      "properties": {
        "hierarchy": {
          "type": "object",
          "required": ["value"],
          "properties": {
            "value": { "enum": ["soft", "balanced", "strong"] },
            "actor": { "type": "string" },
            "origin": { "enum": ["deterministic", "schema-structural", "schema-interpreted", "llm-inferred", "human-confirmed"] },
            "confidence": { "type": "number" },
            "confidenceSource": { "enum": ["deterministic", "second-party", "human-attested"] },
            "requiresApproval": { "type": "boolean" },
            "source": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "cornerRadius": {
          "type": "object",
          "required": ["value"],
          "properties": {
            "value": { "enum": ["sharp", "soft", "rounded", "pill"] },
            "actor": { "type": "string" },
            "origin": { "enum": ["deterministic", "schema-structural", "schema-interpreted", "llm-inferred", "human-confirmed"] },
            "confidence": { "type": "number" },
            "confidenceSource": { "enum": ["deterministic", "second-party", "human-attested"] },
            "requiresApproval": { "type": "boolean" },
            "source": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "personality": {
          "type": "object",
          "required": ["value"],
          "properties": {
            "value": { "enum": ["professional", "friendly", "premium", "playful", "minimal"] },
            "actor": { "type": "string" },
            "origin": { "enum": ["deterministic", "schema-structural", "schema-interpreted", "llm-inferred", "human-confirmed"] },
            "confidence": { "type": "number" },
            "confidenceSource": { "enum": ["deterministic", "second-party", "human-attested"] },
            "requiresApproval": { "type": "boolean" },
            "source": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "deterministic",
        "schema-structural",
        "schema-interpreted",
        "llm-inferred",
        "human-confirmed"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "confidenceSource": {
      "enum": [
        "deterministic",
        "second-party",
        "human-attested"
      ]
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
