{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "enum.schema.v1",
  "title": "EnumModel",
  "type": "object",
  "required": ["name", "values"],
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "values": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" } }
  },
  "additionalProperties": false
}
