{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "repository.schema.v1",
  "title": "RepositoryModel",
  "type": "object",
  "required": ["name", "operations"],
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "returns", "params"],
        "properties": {
          "name": { "type": "string" },
          "returns": { "type": "string" },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "default": { "type": "string" },
                "named": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
