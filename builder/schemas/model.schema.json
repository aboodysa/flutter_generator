{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model.schema.v1",
  "title": "ModelModel (DTO override)",
  "type": "object",
  "required": ["name", "entity"],
  "properties": {
    "name": { "type": "string" },
    "entity": { "type": "string" },
