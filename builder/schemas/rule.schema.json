{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rule.schema.v1",
  "title": "RuleModel",
  "type": "object",
  "required": [
    "name",
    "entity",
    "conditions",
    "result"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "entity": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "operator",
          "value"
        ],
        "properties": {
          "actor": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "deterministic",
              "schema-structural",
              "schema-interpreted",
              "llm-inferred",
              "human-confirmed"
            ]
          },
          "confidence": {
            "type": "number"
          },
          "confidenceSource": {
            "enum": [
              "deterministic",
              "second-party",
              "human-attested"
            ]
          },
          "requiresApproval": {
            "type": "boolean"
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trace": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "field": {
            "type": "string"
          },
          "operator": {
            "enum": [
              ">=",
              "<=",
              ">",
              "<",
              "==",
              "!=",
              "contains",
              "daysSince>",
              "daysSince<"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "operator",
                "value"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "operator": {
                  "enum": [
                    ">=",
                    "<=",
                    ">",
                    "<",
                    "==",
                    "!=",
                    "contains",
                    "daysSince>",
                    "daysSince<"
                  ]
                },
                "value": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "actor": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "deterministic",
        "schema-structural",
        "schema-interpreted",
        "llm-inferred",
        "human-confirmed"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "confidenceSource": {
      "enum": [
        "deterministic",
        "second-party",
        "human-attested"
      ]
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "enum": [
        "autoApprove",
        "warn",
        "requireJustification",
        "block"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
