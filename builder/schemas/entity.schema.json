{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entity.schema.v1",
  "title": "EntityModel",
  "type": "object",
  "required": [
    "name",
    "fields"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "identity": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "deterministic",
            "schema-structural",
            "schema-interpreted",
            "llm-inferred",
            "human-confirmed"
          ]
        },
        "confidence": {
          "type": "number"
        },
        "confidenceSource": {
          "enum": [
            "deterministic",
            "second-party",
            "human-attested"
          ]
        },
        "requiresApproval": {
          "type": "boolean"
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field": {
          "type": "string"
        }
      },
      "required": [
        "field"
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/field"
      }
    },
    "equality": {
      "enum": [
        "identity",
        "full",
        "none"
      ],
      "default": "identity"
    },
    "immutability": {
      "type": "boolean",
      "default": true
    },
    "audited": {
      "type": "boolean",
      "default": false,
      "description": "L3: this entity's create/update/delete mutations are recorded to the app-wide audit log (core/audit.dart) — requires attributes.auth."
    },
    "primaryDisplayField": {
      "type": "string",
      "description": "P2: this entity's own declared primary human-readable identifier (must reference one of this entity's own fields[].name, String-typed). The single explicit semantic composition.ts's searchFor selector reads to decide per-list search — never a title/name/label name-guess. Absent = no search on this entity's list screen."
    },
    "actor": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "deterministic",
        "schema-structural",
        "schema-interpreted",
        "llm-inferred",
        "human-confirmed"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "confidenceSource": {
      "enum": [
        "deterministic",
        "second-party",
        "human-attested"
      ]
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "field": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "type": {
          "enum": [
            "String",
            "int",
            "double",
            "bool",
            "DateTime",
            "enum",
            "List",
            "reference"
          ]
        },
        "of": {
          "type": "string",
          "description": "item type for List, or referenced entity name for reference"
        },
        "enumValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "nullable": {
          "type": "boolean",
          "default": false
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "semanticType": {
          "type": "string",
          "description": "known semantic value-object type: Email, PhoneNumber, Money, NationalId, etc."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "P7-L1: ISO 4217 currency code (e.g. SAR, USD) — required companion to semanticType: \"Money\"; the field is emitted as Money (integer minor units), never double."
        },
        "secret": {
          "type": "boolean",
          "default": false,
          "description": "L3: marks a field as holding sensitive data — export.ts's header-building excludes it from any CSV/JSON export regardless of a list screen's export: flag."
        },
        "role": {
          "enum": ["choice"],
          "description": "V1.1: explicit hint that an enum field is a genuine multiple-choice value (renders as ChoiceChip everywhere, like status/priority) rather than a descriptive category (DropdownButton). Additive — absent = today's behavior."
        },
        "actor": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "deterministic",
            "schema-structural",
            "schema-interpreted",
            "llm-inferred",
            "human-confirmed"
          ]
        },
        "confidence": {
          "type": "number"
        },
        "confidenceSource": {
          "enum": [
            "deterministic",
            "second-party",
            "human-attested"
          ]
        },
        "requiresApproval": {
          "type": "boolean"
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
