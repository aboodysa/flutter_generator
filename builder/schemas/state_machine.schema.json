{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "state_machine.schema.v1",
  "title": "StateMachineModel",
  "type": "object",
  "required": ["name", "states", "events", "transitions"],
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "events": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "event", "to"],
        "properties": { "from": { "type": "string" }, "event": { "type": "string" }, "to": { "type": "string" }, "guard": { "type": "string" } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
