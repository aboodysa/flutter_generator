{
  "schemaVersion": "1",
  "name": "onboarding",
  "attributes": {
    "stateManagement": "bloc"
  },
  "entities": [
    {
      "name": "Signup",
      "identity": {
        "field": "id"
      },
      "fields": [
        {
          "name": "id",
          "type": "String",
          "required": true,
          "nullable": false
        },
        {
          "name": "name",
          "type": "String",
          "required": true,
          "nullable": false
        },
        {
          "name": "email",
          "type": "String",
          "required": true,
          "nullable": false
        }
      ]
    }
  ],
  "businessRules": [
    {
      "name": "EmailValid",
      "entity": "Signup",
      "result": "valid",
      "conditions": [
        {
          "field": "email",
          "operator": "contains",
          "value": "'@'"
        }
      ]
    }
  ],
  "states": [
    {
      "name": "SignupWizard",
      "entity": "Signup"
    }
  ],
  "screens": [
    {
      "name": "SignupWizardScreen",
      "entity": "Signup",
      "type": "wizard",
      "state": "SignupWizard",
      "steps": [
        {
          "id": "name",
          "title": "What's your name?",
          "field": "name"
        },
        {
          "id": "email",
          "title": "What's your email?",
          "field": "email",
          "validate": "EmailValid"
        },
        {
          "id": "review",
          "title": "Review"
        }
      ]
    }
  ]
}
