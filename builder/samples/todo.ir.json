{
  "schemaVersion": "1",
  "name": "todo_app",
  "enums": [
    {
      "name": "Priority",
      "values": [
        "low",
        "medium",
        "high"
      ]
    }
  ],
  "entities": [
    {
      "name": "Task",
      "identity": {
        "field": "id"
      },
      "fields": [
        {
          "name": "id",
          "type": "String",
          "required": true,
          "nullable": false
        },
        {
          "name": "title",
          "type": "String",
          "required": true,
          "nullable": false
        },
        {
          "name": "description",
          "type": "String",
          "required": false,
          "nullable": true
        },
        {
          "name": "dueDate",
          "type": "DateTime",
          "required": true,
          "nullable": true
        },
        {
          "name": "priority",
          "type": "enum",
          "required": true,
          "nullable": false,
          "of": "Priority"
        },
        {
          "name": "isDone",
          "type": "bool",
          "required": true,
          "nullable": false,
          "default": "false"
        }
      ]
    }
  ],
  "queries": [
    {
      "name": "TaskFilter",
      "fields": [
        {
          "name": "priority",
          "type": "Priority"
        },
        {
          "name": "isDone",
          "type": "bool"
        }
      ]
    }
  ],
  "repositories": [
    {
      "name": "TaskRepository",
      "operations": [
        {
          "name": "listTasks",
          "returns": "Future<List<Task>>",
          "params": [
            {
              "name": "filter",
              "type": "TaskFilter",
              "named": true
            }
          ]
        },
        {
          "name": "createTask",
          "returns": "Future<Task>",
          "params": [
            {
              "name": "task",
              "type": "Task",
              "named": false
            }
          ]
        },
        {
          "name": "updateTask",
          "returns": "Future<void>",
          "params": [
            {
              "name": "task",
              "type": "Task",
              "named": false
            }
          ]
        },
        {
          "name": "deleteTask",
          "returns": "Future<void>",
          "params": [
            {
              "name": "id",
              "type": "String",
              "named": false
            }
          ]
        }
      ]
    }
  ],
  "states": [
    {
      "name": "TaskList",
      "entity": "Task",
      "statuses": [
        "initial",
        "loading",
        "success",
        "failure"
      ]
    }
  ],
  "screens": [
    {
      "name": "TaskListScreen",
      "entity": "Task",
      "type": "list",
      "state": "TaskList"
    },
    {
      "name": "TaskDetailScreen",
      "entity": "Task",
      "type": "detail",
      "state": "TaskList"
    }
  ],
  "useCases": [
    {
      "name": "ListTasks",
      "repository": "TaskRepository",
      "operation": "listTasks",
      "paramType": "TaskFilter",
      "returnType": "List<Task>"
    },
    {
      "name": "CreateTask",
      "repository": "TaskRepository",
      "operation": "createTask",
      "paramType": "Task",
      "returnType": "Task"
    },
    {
      "name": "UpdateTask",
      "repository": "TaskRepository",
      "operation": "updateTask",
      "paramType": "Task",
      "returnType": "void"
    },
    {
      "name": "DeleteTask",
      "repository": "TaskRepository",
      "operation": "deleteTask",
      "paramType": "String",
      "returnType": "void"
    }
  ]
}