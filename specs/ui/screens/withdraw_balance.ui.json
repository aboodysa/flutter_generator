{
  "screenId": "withdraw_balance",
  "usesProductSpec": "specs/product/screens/withdraw_balance.product.json",
  "layout": {
    "type": "screen",
    "safeArea": true,
    "scroll": true,
    "regions": {
      "header": {
        "type": "component.appHeader",
        "props": {
          "title": "سحب رصيد",
          "leading": "back"
        }
      },
      "body": {
        "type": "layout.vertical",
        "spacing": "md",
        "padding": "lg",
        "children": [
          {
            "type": "field.text",
            "bindsTo": "bankName",
            "props": {
              "label": "اسم البنك",
              "placeholder": "البنك الأهلي السعودي"
            }
          },
          {
            "type": "field.text",
            "bindsTo": "accountNumber",
            "props": {
              "label": "رقم الحساب",
              "placeholder": "SA0000000000000000"
            }
          },
          {
            "type": "field.text",
            "bindsTo": "iban",
            "props": {
              "label": "رقم الآيبان",
              "placeholder": "SA0000000000000000000000"
            }
          },
          {
            "type": "field.text",
            "bindsTo": "accountHolder",
            "props": {
              "label": "اسم صاحب الحساب"
            }
          },
          {
            "type": "field.amount",
            "bindsTo": "amount",
            "props": {
              "label": "المبلغ",
              "placeholder": "أدخل المبلغ",
              "currency": "ريال"
            }
          },
          {
            "type": "component.banner",
            "variant": "danger",
            "props": {
              "title": "تنبيه",
              "subtitle": "سيتم خصم المبلغ من رصيد محفظتك"
            }
          }
        ]
      },
      "footer": {
        "type": "component.fixedActionBar",
        "primaryAction": "withdraw",
        "props": {
          "buttonLabel": "سحب"
        }
      }
    }
  }
}
