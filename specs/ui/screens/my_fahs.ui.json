{
  "screenId": "my_fahs",
  "usesProductSpec": "specs/product/screens/my_fahs.product.json",
  "layout": {
    "type": "screen",
    "safeArea": true,
    "scroll": true,
    "regions": {
      "header": {
        "type": "component.logoHeader",
        "props": {
          "logo": "فحص FAHS"
        }
      },
      "body": {
        "type": "layout.vertical",
        "spacing": "md",
        "padding": "lg",
        "children": [
          {
            "type": "layout.horizontal",
            "spacing": "sm",
            "children": [
              {
                "type": "component.card",
                "action": "startInspection",
                "props": {
                  "icon": "inspection",
                  "label": "فحص السيارة"
                }
              },
              {
                "type": "component.card",
                "action": "startOwnershipTransfer",
                "props": {
                  "icon": "transfer",
                  "label": "نقل الملكية"
                }
              }
            ]
          },
          {
            "type": "component.walletCard",
            "action": "navigateToWallet",
            "props": {
              "balance": "١٢٥ ريال",
              "label": "رصيد المحفظة"
            }
          },
          {
            "type": "component.card",
            "variant": "orders",
            "action": "navigateToMyOrders",
            "props": {
              "icon": "orders",
              "label": "طلباتي",
              "count": "٣"
            }
          },
          {
            "type": "component.card",
            "variant": "vehicles",
            "action": "navigateToMyVehicles",
            "props": {
              "icon": "vehicles",
              "label": "مركباتي",
              "count": "٢"
            }
          },
          {
            "type": "component.card",
            "variant": "ads",
            "action": "navigateToMyAds",
            "props": {
              "icon": "ads",
              "label": "إعلاناتي",
              "count": "١"
            }
          }
        ]
      },
      "footer": {
        "type": "component.bottomNav",
        "props": {
          "activeIndex": 1,
          "items": [
            { "label": "الرئيسية", "icon": "home", "route": "/home" },
            { "label": "My FAHS", "icon": "settings", "route": "/my-fahs" },
            { "label": "الشات", "icon": "chat", "route": "/chat" },
            { "label": "حسابي", "icon": "profile", "route": "/profile" }
          ]
        }
      }
    }
  }
}
