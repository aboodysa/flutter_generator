{
  "screenId": "add_balance",
  "usesProductSpec": "specs/product/screens/add_balance.product.json",
  "layout": {
    "type": "screen",
    "safeArea": true,
    "scroll": true,
    "regions": {
      "header": {
        "type": "component.appHeader",
        "props": {
          "title": "إضافة رصيد",
          "leading": "back"
        }
      },
      "body": {
        "type": "layout.vertical",
        "spacing": "md",
        "padding": "lg",
        "children": [
          {
            "type": "field.amount",
            "bindsTo": "amount",
            "props": {
              "label": "المبلغ",
              "placeholder": "أدخل المبلغ",
              "currency": "ريال"
            }
          },
          {
            "type": "component.paymentMethodList",
            "bindsTo": "paymentMethod",
            "props": {
              "label": "طريقة الدفع",
              "methods": [
                { "id": "card", "label": "بطاقة ائتمان", "icon": "card" },
                { "id": "bank", "label": "تحويل بنكي", "icon": "bank" },
                { "id": "stcPay", "label": "STC Pay", "icon": "stc" }
              ]
            }
          }
        ]
      },
      "footer": {
        "type": "component.fixedActionBar",
        "primaryAction": "addFunds",
        "props": {
          "buttonLabel": "إضافة"
        }
      }
    }
  }
}
