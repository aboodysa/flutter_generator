{
  "screenId": "personal_data",
  "usesProductSpec": "specs/product/screens/personal_data.product.json",
  "layout": {
    "type": "screen",
    "safeArea": true,
    "scroll": true,
    "regions": {
      "header": {
        "type": "component.appHeader",
        "props": {
          "title": "البيانات الشخصية",
          "leading": "back"
        }
      },
      "body": {
        "type": "layout.vertical",
        "spacing": "md",
        "padding": "lg",
        "children": [
          {
            "type": "field.text",
            "bindsTo": "fullName",
            "props": {
              "label": "الاسم الكامل",
              "placeholder": "أحمد محمد"
            }
          },
          {
            "type": "field.phone",
            "bindsTo": "phoneNumber",
            "props": {
              "label": "رقم الهاتف",
              "placeholder": "+966 59 877 7733",
              "readOnly": true
            }
          },
          {
            "type": "field.text",
            "bindsTo": "email",
            "props": {
              "label": "البريد الإلكتروني",
              "placeholder": "ahmed@example.com"
            }
          }
        ]
      },
      "footer": {
        "type": "component.fixedActionBar",
        "primaryAction": "saveData",
        "props": {
          "buttonLabel": "حفظ"
        }
      }
    }
  }
}
