            }
          },
          {
            "type": "layout.grid",
            "columns": 2,
            "spacing": "sm",
            "children": [
              {
                "type": "field.text",
                "props": {
                  "label": "الماركة",
                  "value": "تويوتا"
                }
              },
              {
                "type": "field.text",
                "props": {
                  "label": "الموديل",
                  "value": "كورولا"
                }
              },
              {
                "type": "field.text",
                "props": {
                  "label": "السنة",
                  "value": "٢٠٢٤"
                }
              }
            ]
          }
        ]
      },
      "footer": {
        "type": "component.fixedActionBar",
