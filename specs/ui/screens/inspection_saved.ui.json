{
  "screenId": "inspection_saved",
  "usesProductSpec": "specs/product/screens/inspection_saved.product.json",
  "layout": {
    "type": "screen",
    "safeArea": true,
    "scroll": true,
    "regions": {
      "header": {
        "type": "component.appHeader",
        "props": {
          "title": "فحص المركبة",
          "leading": "back"
        }
      },
      "body": {
        "type": "layout.vertical",
        "spacing": "md",
        "padding": "lg",
        "children": [
          {
            "type": "component.card",
            "variant": "default",
            "props": {
              "icon": "car",
              "title": "تويوتا كورولا ٢٠٢٤"
            }
          },
          {
            "type": "component.plate",
            "props": {
              "plateNumber": "ABC 1234",
