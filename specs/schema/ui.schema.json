{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Composition Spec Schema",
  "type": "object",
  "required": ["screenId", "usesProductSpec", "layout"],
  "properties": {
    "screenId": { "type": "string" },
    "usesProductSpec": { "type": "string" },
    "sourceEvidence": { "type": "object" },
    "renderEvidence": { "type": "object" },
    "refinementLog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "screenId": { "type": "string" },
          "fieldPath": { "type": "string" },
          "field": { "type": "string" },
          "before": {},
          "after": {},
          "provenance": {
            "type": "object",
            "properties": {
              "source": { "type": "string", "enum": ["raw_html", "rendered_html"] },
              "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
              "inferenceLevel": { "type": "string", "enum": ["direct", "inferred"] },
              "caption": { "type": "string" },
              "screenId": { "type": "string" },
              "evidence": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "required": ["screenId", "fieldPath", "field", "provenance"]
      }
    },
    "layout": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["screen"] },
        "safeArea": { "type": "boolean" },
        "scroll": { "type": "boolean" },
        "regions": { "type": "object" }
      }
    }
  },
  "additionalProperties": false
}
