{
  "colors": {
    "brand.primary": "#7237E9",
    "brand.primaryDark": "#5F24D8",
    "brand.lavender": "#EFE9FB",
    "brand.lavenderLight": "#F4EEFF",
    "brand.peach": "#FDECE3",
    "surface.background": "#F5F5F5",
    "surface.cultured": "#F7F7F7",
    "surface.default": "#FFFFFF",
    "surface.line": "#E7E7E7",
    "text.primary": "#121212",
    "text.muted": "#8C8C8C",
    "text.placeholder": "#A5A5A5",
    "text.onPrimary": "#FFFFFF",
    "status.success": "#36D88E",
    "status.error": "#E4143E",
    "status.warning": "#FFE4A8",
    "status.warningText": "#8B6B18",
    "status.info": "#DDE9FF",
    "status.infoText": "#306DCE",
    "status.successBg": "#DFFBEF",
    "status.successText": "#09965C",
    "status.errorBg": "#FFE5EA",
    "status.neutral": "#AFAFAF",
    "extras.blue": "#8DB7FF",
    "extras.teal": "#16B998",
    "extras.orange": "#F2A919",
    "extras.whatsapp": "#25D366",
    "extras.stcPay": "#6B0DA9"
  },
  "typography": {
    "fontFamily": "Tajawal",
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700,
      "extraBold": 800
    },
    "sizes": {
      "xs": 12,
      "sm": 13,
      "base": 14,
      "md": 15,
      "lg": 17,
      "xl": 24,
      "xxl": 28,
      "display": 34
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 18,
    "xxl": 22,
    "section": 28
  },
  "radius": {
    "xs": 6,
    "sm": 8,
    "md": 10,
    "lg": 12,
    "xl": 18,
    "full": 48
  },
  "shadows": {
    "card": "0 1px 0 #ccc, 0 16px 32px rgba(0,0,0,0.12)",
    "elevation1": "0 3px 10px rgba(0,0,0,0.08)"
  },
  "surfaces": {
    "screen": {
      "background": "surface.background",
      "safeArea": true
    },
    "card": {
      "background": "surface.default",
      "radius": "radius.md",
      "border": "1px solid surface.line"
    },
    "topBar": {
      "background": "surface.default",
      "height": 54,
      "borderBottom": "1px solid #eee"
    },
    "bottomNav": {
      "background": "surface.default",
      "height": 64
    },
    "input": {
      "background": "surface.default",
      "height": 50,
      "radius": "radius.sm",
      "border": "1px solid #ddd",
      "focusBorderColor": "brand.primary",
      "focusShadow": "0 0 0 2px rgba(114,55,233,0.08)"
    },
    "button": {
      "primary": {
        "background": "brand.primary",
        "textColor": "text.onPrimary",
        "height": 48,
        "radius": "radius.sm"
      },
      "outline": {
        "background": "surface.default",
        "textColor": "brand.primary",
        "border": "1px solid brand.primary"
      },
      "ghost": {
        "background": "surface.default",
        "textColor": "text.primary",
        "border": "1px solid surface.line"
      },
      "disabled": {
        "background": "status.neutral",
        "textColor": "text.onPrimary"
      }
    }
  },
  "direction": "rtl",
  "breakpoints": {
    "phoneWidth": 390,
    "phoneHeight": 844
  }
}
