{
  "name": "fahs-specs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "validate": "npx ts-node tools/specs/validate.ts specs",
    "generate:router": "npx ts-node tools/generate_router.ts",
    "generate:screens": "npx ts-node tools/generate_flutter.ts --all --mode strict",
    "generate:screen": "npx ts-node tools/generate_flutter.ts --screen",
    "typecheck": "npx tsc --noEmit",
    "test": "npx jest --passWithNoTests"
  },
  "dependencies": {
    "@types/node": "^20.0.0",
    "ajv": "^8.12.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11"
  }
}
