# orchestrator-kit configuration — copy this file to `config.env` (in the kit root, next to
# core/ and adapters/) and edit. core/init.sh sources config.env for every script, so settings
# live here once instead of being duplicated. Every value here is a default that the scripts
# fall back on if config.env is absent — uncomment/adjust only what your project needs.

# Progress reporting level read by core/report.sh (L0 < L1 < L2 < L3). Default L2.
#   L0 completion + blockers only · L1 + milestones/retries · L2 + decisions/verify (default)
#   L3 + detailed tool activity. Auto-jumps to L3 on any failure, returns on recovery.
ORCH_PROGRESS_LEVEL=L2

# --- Telegram adapter (adapters/tgsend.sh) ----------------------------------------
# File containing the bot token (read once per call) and the target chat id.
# ORCH_TG_TOKEN_FILE="${HOME}/.mac_companion/token"
# ORCH_TG_CHAT_ID=1117739189

# --- Remote-host adapter (adapters/dispatch_kill_fresh.sh) ------------------------
# One SSH-target / opencode-binary pair per host *name*; pass that name as --host <name>.
# ORCH_HOST_SSH_tracematrix=root@tracematrix.businessanalystcrew.org
# ORCH_HOST_OPCODE_tracematrix=/usr/local/bin/opencode
# ORCH_HOST_SSH_tracematrix001=root@tracematrix001.businessanalystcrew.org
# ORCH_HOST_OPCODE_tracematrix001=/root/.opencode/bin/opencode

# --- Machine adapter example (examples/pdf_build.sh) ------------------------------
# Headless-Chrome-for-Testing binary used for HTML->PDF, and a pinned caption font for the
# ImageMagick contact-sheet builder. Override per machine.
# ORCH_CFT_CHROME="/Users/username/temp/opencode/chrome-cft/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"
# ORCH_CAPTION_FONT="/System/Library/Fonts/Supplemental/Arial.ttf"
