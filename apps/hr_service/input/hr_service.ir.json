      "repository": "LeaveRequestRepository",
      "operation": "listLeaveRequests",
      "paramType": "NoParams",
      "returnType": "List<LeaveRequest>"
    },
    {
      "name": "GetLeaveRequest",
      "repository": "LeaveRequestRepository",
      "operation": "getLeaveRequest",
