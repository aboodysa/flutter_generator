      "repository": "LeaveRequestRepository",
      "operation": "createLeaveRequest",
      "paramType": "LeaveRequest",
      "returnType": "LeaveRequest"
    },
    {
      "name": "UpdateLeaveRequest",
      "repository": "LeaveRequestRepository",
      "operation": "updateLeaveRequest",
      "paramType": "LeaveRequest",
      "returnType": "void"
    },
    {
      "name": "DeleteLeaveRequest",
      "repository": "LeaveRequestRepository",
      "operation": "deleteLeaveRequest",
