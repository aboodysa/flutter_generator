            "field": "id"
          },
          "fields": [
            {
              "name": "id",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "name",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "email",
              "type": "String",
              "required": true,
              "nullable": false
