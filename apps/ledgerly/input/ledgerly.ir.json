{
  "schemaVersion": "1",
  "name": "ledgerly",
  "attributes": {
    "stateManagement": "bloc",
    "auth": {
      "roles": [
        "employee",
        "manager",
        "finance"
      ],
      "home": {
        "employee": "ExpenseClaim",
        "manager": "ExpenseClaim",
        "finance": "Approval"
      },
      "allow": {
        "employee": [
          "ExpenseClaim",
          "Approval",
          "MealBudget"
        ],
        "manager": [
          "ExpenseClaim",
          "Approval",
          "MealBudget"
        ],
        "finance": [
          "ExpenseClaim",
          "Approval",
          "User",
          "MealBudget",
          "AuditLog"
        ]
      }
    },
    "budget": {
      "entity": "MealBudget",
      "limitField": "limit",
      "committedField": "committed",
      "actualField": "actual",
      "scope": "category",
      "period": "monthly"
    },
    "locale": "both",
    "attachments": true,
    "outbox": true
  },
  "features": [
    {
      "name": "auth",
      "enums": [
        {
          "name": "UserRole",
          "values": [
            "employee",
            "manager",
            "finance"
          ]
        }
      ],
      "entities": [
        {
          "name": "User",
          "identity": {
            "field": "id"
          },
          "primaryDisplayField": "name",
          "fields": [
            {
              "name": "id",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "name",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "email",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "role",
              "type": "enum",
              "required": true,
              "nullable": false,
              "of": "UserRole"
            }
          ]
        }
      ],
      "repositories": [
        {
          "name": "UserRepository",
          "operations": [
            {
              "name": "listUsers",
              "returns": "Future<List<User>>",
              "params": []
            }
          ]
        }
      ],
      "states": [
        {
          "name": "UserList",
          "entity": "User"
        }
      ],
      "screens": [
        {
          "name": "UserListScreen",
          "entity": "User",
          "type": "list",
          "state": "UserList"
        }
      ],
      "useCases": [
        {
          "name": "ListUsers",
          "repository": "UserRepository",
          "operation": "listUsers",
          "paramType": "NoParams",
          "returnType": "List<User>"
        }
      ]
    },
    {
      "name": "expenses",
      "enums": [
        {
          "name": "ClaimStatus",
          "values": [
            "pending",
            "approved",
            "rejected"
          ]
        }
      ],
      "entities": [
        {
          "name": "ExpenseClaim",
          "identity": {
            "field": "id"
          },
          "primaryDisplayField": "name",
          "fields": [
            {
              "name": "id",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "name",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "amount",
              "type": "double",
              "required": true,
              "nullable": false,
              "semanticType": "Money",
              "currency": "SAR"
            },
            {
              "name": "status",
              "type": "enum",
              "required": true,
              "nullable": false,
              "of": "ClaimStatus",
              "default": "pending"
            },
            {
              "name": "exported",
              "type": "bool",
              "required": true,
              "nullable": false,
              "default": false
            }
          ],
          "audited": true
        },
        {
          "name": "ExpenseClaimSplit",
          "identity": {
            "field": "id"
          },
          "fields": [
            {
              "name": "id",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "expenseClaimId",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "category",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "percent",
              "type": "double",
              "required": true,
              "nullable": false
            }
          ]
        }
      ],
      "repositories": [
        {
          "name": "ExpenseClaimRepository",
          "operations": [
            {
              "name": "listExpenseClaims",
              "returns": "Future<List<ExpenseClaim>>",
              "params": []
            },
            {
              "name": "createExpenseClaim",
              "returns": "Future<ExpenseClaim>",
              "params": [
                {
                  "name": "claim",
                  "type": "ExpenseClaim",
                  "named": false
                }
              ]
            },
            {
              "name": "updateExpenseClaim",
              "returns": "Future<void>",
              "params": [
                {
                  "name": "claim",
                  "type": "ExpenseClaim",
                  "named": false
                }
              ]
            },
            {
              "name": "deleteExpenseClaim",
              "returns": "Future<void>",
              "params": [
                {
                  "name": "id",
                  "type": "String",
                  "named": false
                }
              ]
            }
          ]
        },
        {
          "name": "ExpenseClaimSplitRepository",
          "operations": [
            {
              "name": "listExpenseClaimSplits",
              "returns": "Future<List<ExpenseClaimSplit>>",
              "params": []
            },
            {
              "name": "createExpenseClaimSplit",
              "returns": "Future<ExpenseClaimSplit>",
              "params": [
                {
                  "name": "split",
                  "type": "ExpenseClaimSplit",
                  "named": false
                }
              ]
            },
            {
              "name": "updateExpenseClaimSplit",
              "returns": "Future<void>",
              "params": [
                {
                  "name": "split",
                  "type": "ExpenseClaimSplit",
                  "named": false
                }
              ]
            },
            {
              "name": "deleteExpenseClaimSplit",
              "returns": "Future<void>",
              "params": [
                {
                  "name": "id",
                  "type": "String",
                  "named": false
                }
              ]
            }
          ]
        }
      ],
      "states": [
        {
          "name": "ExpenseClaimList",
          "entity": "ExpenseClaim"
        },
        {
          "name": "ExpenseClaimSplitList",
          "entity": "ExpenseClaimSplit"
        }
      ],
      "screens": [
        {
          "name": "ExpenseClaimListScreen",
          "entity": "ExpenseClaim",
          "type": "list",
          "state": "ExpenseClaimList",
          "export": "csv"
        },
        {
          "name": "ExpenseClaimDetailScreen",
          "entity": "ExpenseClaim",
          "type": "detail",
          "state": "ExpenseClaimList"
        }
      ],
      "useCases": [
        {
          "name": "ListExpenseClaims",
          "repository": "ExpenseClaimRepository",
          "operation": "listExpenseClaims",
          "paramType": "NoParams",
          "returnType": "List<ExpenseClaim>"
        },
        {
          "name": "CreateExpenseClaim",
          "repository": "ExpenseClaimRepository",
          "operation": "createExpenseClaim",
          "paramType": "ExpenseClaim",
          "returnType": "ExpenseClaim"
        },
        {
          "name": "UpdateExpenseClaim",
          "repository": "ExpenseClaimRepository",
          "operation": "updateExpenseClaim",
          "paramType": "ExpenseClaim",
          "returnType": "void"
        },
        {
          "name": "DeleteExpenseClaim",
          "repository": "ExpenseClaimRepository",
          "operation": "deleteExpenseClaim",
          "paramType": "String",
          "returnType": "void"
        },
        {
          "name": "ListExpenseClaimSplits",
          "repository": "ExpenseClaimSplitRepository",
          "operation": "listExpenseClaimSplits",
          "paramType": "NoParams",
          "returnType": "List<ExpenseClaimSplit>"
        },
        {
          "name": "CreateExpenseClaimSplit",
          "repository": "ExpenseClaimSplitRepository",
          "operation": "createExpenseClaimSplit",
          "paramType": "ExpenseClaimSplit",
          "returnType": "ExpenseClaimSplit"
        },
        {
          "name": "UpdateExpenseClaimSplit",
          "repository": "ExpenseClaimSplitRepository",
          "operation": "updateExpenseClaimSplit",
          "paramType": "ExpenseClaimSplit",
          "returnType": "void"
        },
        {
          "name": "DeleteExpenseClaimSplit",
          "repository": "ExpenseClaimSplitRepository",
          "operation": "deleteExpenseClaimSplit",
          "paramType": "String",
          "returnType": "void"
        }
      ],
      "businessRules": [
        {
          "name": "MicroExpenseAutoApprove",
          "entity": "ExpenseClaim",
          "result": "true",
          "conditions": [
            {
              "field": "amount",
              "operator": "<=",
              "value": "50"
            }
          ],
          "severity": "autoApprove",
          "message": "Expenses of 50 SAR or less are auto-approved without manager review."
        },
        {
          "name": "StandardExpenseWarn",
          "entity": "ExpenseClaim",
          "result": "true",
          "conditions": [
            {
              "field": "amount",
              "operator": ">=",
              "value": "500"
            }
          ],
          "severity": "warn",
          "message": "This expense is unusually large \u2014 please double-check the amount before submitting."
        },
        {
          "name": "LargeExpenseJustify",
          "entity": "ExpenseClaim",
          "result": "true",
          "conditions": [
            {
              "field": "amount",
              "operator": ">=",
              "value": "2000"
            }
          ],
          "severity": "requireJustification",
          "message": "Expenses of 2,000 SAR or more require a written justification."
        },
        {
          "name": "ExecutiveExpenseBlock",
          "entity": "ExpenseClaim",
          "result": "true",
          "conditions": [
            {
              "field": "amount",
              "operator": ">=",
              "value": "15000"
            }
          ],
          "severity": "block",
          "message": "Expenses of 15,000 SAR or more require executive approval outside this system."
        }
      ]
    },
    {
      "name": "approvals",
      "enums": [
        {
          "name": "ApprovalDecision",
          "values": [
            "pending",
            "approved",
            "rejected"
          ]
        }
      ],
      "entities": [
        {
          "name": "Approval",
          "identity": {
            "field": "id"
          },
          "primaryDisplayField": "name",
          "fields": [
            {
              "name": "id",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "name",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "decision",
              "type": "enum",
              "required": true,
              "nullable": false,
              "of": "ApprovalDecision",
              "default": "pending"
            }
          ]
        }
      ],
      "repositories": [
        {
          "name": "ApprovalRepository",
          "operations": [
            {
              "name": "listApprovals",
              "returns": "Future<List<Approval>>",
              "params": []
            },
            {
              "name": "updateApproval",
              "returns": "Future<void>",
              "params": [
                {
                  "name": "approval",
                  "type": "Approval",
                  "named": false
                }
              ]
            }
          ]
        }
      ],
      "states": [
        {
          "name": "ApprovalList",
          "entity": "Approval"
        }
      ],
      "screens": [
        {
          "name": "ApprovalListScreen",
          "entity": "Approval",
          "type": "list",
          "state": "ApprovalList"
        }
      ],
      "useCases": [
        {
          "name": "ListApprovals",
          "repository": "ApprovalRepository",
          "operation": "listApprovals",
          "paramType": "NoParams",
          "returnType": "List<Approval>"
        },
        {
          "name": "UpdateApproval",
          "repository": "ApprovalRepository",
          "operation": "updateApproval",
          "paramType": "Approval",
          "returnType": "void"
        }
      ],
      "businessRules": [
        {
          "name": "ApprovalRejectedWarn",
          "entity": "Approval",
          "result": "true",
          "conditions": [
            {
              "field": "decision",
              "operator": "==",
              "value": "rejected"
            }
          ],
          "severity": "warn",
          "message": "A rejected approval requires the requester to be notified and the claim revised."
        }
      ]
    },
    {
      "name": "budgets",
      "entities": [
        {
          "name": "MealBudget",
          "identity": {
            "field": "id"
          },
          "primaryDisplayField": "name",
          "fields": [
            {
              "name": "id",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "name",
              "type": "String",
              "required": true,
              "nullable": false
            },
            {
              "name": "limit",
              "type": "double",
              "required": true,
              "nullable": false,
              "semanticType": "Money",
              "currency": "SAR"
            },
            {
              "name": "committed",
              "type": "double",
              "required": true,
              "nullable": false,
              "semanticType": "Money",
              "currency": "SAR"
            },
            {
              "name": "actual",
              "type": "double",
              "required": true,
              "nullable": false,
              "semanticType": "Money",
              "currency": "SAR"
            }
          ]
        }
      ],
      "repositories": [
        {
          "name": "MealBudgetRepository",
          "operations": [
            {
              "name": "listMealBudgets",
              "returns": "Future<List<MealBudget>>",
              "params": []
            },
            {
              "name": "createMealBudget",
              "returns": "Future<MealBudget>",
              "params": [
                {
                  "name": "budget",
                  "type": "MealBudget",
                  "named": false
                }
              ]
            },
            {
              "name": "updateMealBudget",
              "returns": "Future<void>",
              "params": [
                {
                  "name": "budget",
                  "type": "MealBudget",
                  "named": false
                }
              ]
            },
            {
              "name": "deleteMealBudget",
              "returns": "Future<void>",
              "params": [
                {
                  "name": "id",
                  "type": "String",
                  "named": false
                }
              ]
            }
          ]
        }
      ],
      "states": [
        {
          "name": "MealBudgetList",
          "entity": "MealBudget"
        }
      ],
      "screens": [
        {
          "name": "MealBudgetListScreen",
          "entity": "MealBudget",
          "type": "list",
          "state": "MealBudgetList"
        },
        {
          "name": "MealBudgetDetailScreen",
          "entity": "MealBudget",
          "type": "detail",
          "state": "MealBudgetList"
        }
      ],
      "useCases": [
        {
          "name": "ListMealBudgets",
          "repository": "MealBudgetRepository",
          "operation": "listMealBudgets",
          "paramType": "NoParams",
          "returnType": "List<MealBudget>"
        },
        {
          "name": "CreateMealBudget",
          "repository": "MealBudgetRepository",
          "operation": "createMealBudget",
          "paramType": "MealBudget",
          "returnType": "MealBudget"
        },
        {
          "name": "UpdateMealBudget",
          "repository": "MealBudgetRepository",
          "operation": "updateMealBudget",
          "paramType": "MealBudget",
          "returnType": "void"
        },
        {
          "name": "DeleteMealBudget",
          "repository": "MealBudgetRepository",
          "operation": "deleteMealBudget",
          "paramType": "String",
          "returnType": "void"
        }
      ],
      "businessRules": [
        {
          "name": "BudgetCommittedWarn",
          "entity": "MealBudget",
          "result": "true",
          "conditions": [
            {
              "field": "committed",
              "operator": ">=",
              "value": "300"
            }
          ],
          "severity": "warn",
          "message": "Committed spend for this category is high \u2014 review before approving more expenses."
        },
        {
          "name": "BudgetCommittedBlock",
          "entity": "MealBudget",
          "result": "true",
          "conditions": [
            {
              "field": "committed",
              "operator": ">=",
              "value": "800"
            }
          ],
          "severity": "block",
          "message": "Committed spend has reached the category cap \u2014 no further commitments allowed."
        },
        {
          "name": "BudgetActualJustify",
          "entity": "MealBudget",
          "result": "true",
          "conditions": [
            {
              "field": "actual",
              "operator": ">=",
              "value": "400"
            }
          ],
          "severity": "requireJustification",
          "message": "Actual spend in this category requires justification before period close."
        }
      ]
    }
  ]
}